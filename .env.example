# 업비트 API 인증 정보
# 업비트 API 페이지: https://upbit.com/service_center/open_api_guide
UPBIT_ACCESS_KEY=your-access-key-here
UPBIT_SECRET_KEY=your-secret-key-here

# 선택: 거래 모드 (LIVE 또는 TEST)
# 기본값: LIVE (실거래)
CRYPTO_TRADING_MODE=LIVE

# 선택: 일일 최대 손실 제한 (예: -0.10 = -10%)
CRYPTO_DAILY_LOSS_LIMIT=-0.10

# 선택: 최대 포지션 비율 (예: 0.20 = 자산의 20%)
CRYPTO_MAX_POSITION_PERCENT=0.20
