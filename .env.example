# Runtime
APP_ENV=development
LOG_LEVEL=info
LIVE_TRADING_ENABLED=false
TOSS_READ_ONLY_MODE=true

# Toss Securities Open API placeholders only.
TOSS_API_BASE_URL=replace-with-official-api-base-url
TOSS_CLIENT_ID=replace-with-local-secret
TOSS_CLIENT_SECRET=replace-with-local-secret
TOSS_ACCOUNT_REF=replace-with-local-secret

# Naver News API placeholders only.
NAVER_CLIENT_ID=replace-with-local-secret
NAVER_CLIENT_SECRET=replace-with-local-secret

# Claude API placeholder only.
CLAUDE_API_KEY=replace-with-local-secret

# Automated recommendation pipeline (src/application/pipeline). Never places
# a real order - see README.md "Automated Recommendation Pipeline".
CLOUDFLARE_ACCOUNT_ID=replace-with-local-secret
CLOUDFLARE_D1_DATABASE_ID=replace-with-local-secret
CLOUDFLARE_API_TOKEN=replace-with-local-secret
PIPELINE_WATCHLIST=005930:Samsung Electronics:KR:STOCK,000660:SK Hynix:KR:STOCK
PIPELINE_KILL_SWITCH_ACTIVE=false
PIPELINE_KILL_SWITCH_REASON=
