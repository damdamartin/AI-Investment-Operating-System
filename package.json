{
  "name": "ai-investment-operating-system",
  "version": "0.5.18",
  "private": true,
  "type": "module",
  "description": "Safety-first AI Investment Operating System foundation.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=verbose",
    "test:migrations": "vitest run tests/persistence/migrations.test.ts",
    "check": "npm run typecheck && npm test",
    "phase5:toss:readiness": "node scripts/check-toss-readiness.mjs",
    "phase5:toss:endpoints": "node scripts/validate-toss-endpoints.mjs",
    "phase5:toss:plan": "node scripts/plan-toss-read-only-verification.mjs",
    "phase5:toss:evidence": "node scripts/validate-toss-evidence-manifest.mjs",
    "phase5:toss:intake": "node scripts/validate-toss-evidence-intake.mjs",
    "phase5:toss:promote-intake": "node scripts/promote-toss-evidence-intake.mjs",
    "phase5:toss:doctor": "node scripts/phase5-toss-doctor.mjs",
    "phase5:toss:open-questions": "node scripts/report-toss-open-questions.mjs",
    "phase5:toss:preflight": "node scripts/phase5-toss-preflight.mjs",
    "phase5:toss:call-gate": "node scripts/phase5-toss-call-gate.mjs",
    "phase5:toss:completion": "node scripts/phase5-toss-completion.mjs",
    "phase5:toss:local-setup": "node scripts/phase5-toss-local-setup.mjs",
    "phase5:toss:account-ref": "node scripts/phase5-toss-account-ref-setup.mjs",
    "phase5:toss:verify-read-only": "node scripts/phase5-toss-read-only-verify.mjs",
    "phase5:toss:operator:endpoints": "node scripts/validate-toss-endpoints.mjs docs/phase5/toss-read-only-endpoints.operator.json",
    "phase5:toss:operator:doctor": "node scripts/phase5-toss-doctor.mjs docs/phase5/toss-read-only-endpoints.operator.json docs/phase5/evidence-manifest.operator.json docs/phase5/evidence-intake.operator.json",
    "phase5:toss:operator:preflight": "node scripts/phase5-toss-preflight.mjs docs/phase5/toss-read-only-endpoints.operator.json docs/phase5/evidence-manifest.operator.json docs/phase5/evidence-intake.operator.json",
    "phase5:toss:operator:call-gate": "node scripts/phase5-toss-call-gate.mjs docs/phase5/toss-read-only-endpoints.operator.json docs/phase5/evidence-manifest.operator.json docs/phase5/evidence-intake.operator.json",
    "phase5:toss:operator:completion": "node scripts/phase5-toss-completion.mjs docs/phase5/toss-read-only-endpoints.operator.json docs/phase5/evidence-manifest.operator.json docs/phase5/evidence-intake.operator.json",
    "phase10:first-order:candidate": "node scripts/phase10-first-order-candidate-review.mjs",
    "pipeline:run-cycle": "node dist/src/entrypoints/run-trading-cycle.js",
    "deploy:cloudflare:pages": "npx wrangler pages deploy public --project-name ai-investment-operating-system",
    "deploy:cloudflare:worker": "npm run build && wrangler deploy --env production",
    "worker:dev": "npm run build && wrangler dev --env production",
    "worker:secret": "wrangler secret put"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.115.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0"
  }
}
