{
  "name": "ai-investment-operating-system",
  "version": "0.5.16",
  "private": true,
  "type": "module",
  "description": "Safety-first AI Investment Operating System foundation.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:migrations": "vitest run tests/persistence/migrations.test.ts",
    "check": "npm run typecheck && npm test",
    "phase5:toss:readiness": "node scripts/check-toss-readiness.mjs",
    "phase5:toss:endpoints": "node scripts/validate-toss-endpoints.mjs",
    "phase5:toss:plan": "node scripts/plan-toss-read-only-verification.mjs",
    "phase5:toss:evidence": "node scripts/validate-toss-evidence-manifest.mjs",
    "phase5:toss:intake": "node scripts/validate-toss-evidence-intake.mjs",
    "phase5:toss:promote-intake": "node scripts/promote-toss-evidence-intake.mjs",
    "phase5:toss:doctor": "node scripts/phase5-toss-doctor.mjs",
    "phase5:toss:open-questions": "node scripts/report-toss-open-questions.mjs",
    "phase5:toss:preflight": "node scripts/phase5-toss-preflight.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^24.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
