{
  "name": "ai-investment-operating-system",
  "version": "0.5.7",
  "private": true,
  "type": "module",
  "description": "Safety-first AI Investment Operating System foundation.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
